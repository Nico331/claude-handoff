{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/handoff",
            "args": ["hook", "session-start"],
            "timeout": 10,
            "statusMessage": "Loading handoff"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/handoff",
            "args": ["hook", "prompt"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
